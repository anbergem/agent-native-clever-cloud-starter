# Node dev server (`pnpm dev`). Copy to `.env`, which is git-ignored.
# Names only: never commit a real value. See docs/plan/03-blueprint.md B13.

APP_ENV=local
DATABASE_URL=file:./data/app.db
APP_URL=http://localhost:8080

# 32 characters or more. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

AUTO_CREATE_DEFAULT_ORG=0
AGENT_NATIVE_DISABLE_AUTO_DEV_ACCOUNT=1
AUTH_REQUIRE_EMAIL_VERIFICATION=0

SEED_ENABLED=1
SEED_PASSWORD=Example-Seed-Password-2026

# Agent engine. `ai-sdk:anthropic` rather than the framework default `anthropic`,
# because the Cloudflare build stubs `@anthropic-ai/sdk` out of the Worker bundle
# and the native engine cannot load there (see `wrangler.jsonc`). Kept here too so
# `pnpm dev` and the evals exercise the same engine the deployment runs.
AGENT_ENGINE=ai-sdk:anthropic

# Optional locally: only the agent chat and the evals need it.
ANTHROPIC_API_KEY=
